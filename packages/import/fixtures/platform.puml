@startuml Platform
title Platform Components
left to right direction
skinparam componentStyle rectangle
!include <C4/C4_Container>
actor "Customer" as customer
cloud "Azure" {
  node "AKS Cluster" as aks {
    component [Web Front] as web
    component "Orders API" as api <<ASP.NET>>
    queue "Order Events" as events
  }
  database "Orders DB" as db
}
interface "Payments API" as pay
[Mailer]
customer --> web : browses
web -> api : calls
api ..> events : publishes
api -[#red]-> db : reads and writes
[Mailer] ..> events
api --> pay
@enduml
