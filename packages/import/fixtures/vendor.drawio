        <mxCell id="boxicon" value="" style="image;html=1;image=img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="1">
          <mxGeometry x="50" y="250" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="reads" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="app" target="kv" parent="1">
