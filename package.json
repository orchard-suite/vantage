{
  "name": "vantage",
  "version": "4.4.6",
  "private": true,
  "description": "Code-first, multi-perspective software and infrastructure diagrams with human-grade layout. Built for agents.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter @vantage/viewer build",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc -p tsconfig.json",
    "lint:sizes": "scripts/check-file-sizes.sh",
    "check": "bun run typecheck && bun run test && bun run lint:sizes",
    "goldens": "bun scripts/update-goldens.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@vantage/layout": "workspace:*",
    "@vantage/model": "workspace:*",
    "@vantage/render": "workspace:*"
  }
}
